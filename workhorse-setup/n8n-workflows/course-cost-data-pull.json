{
  "name": "Course Cost Data Pull",
  "nodes": [
    {
      "id": "c3d4e5f6-3333-4000-8000-000000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 6,
              "triggerAtMinute": 30
            }
          ]
        }
      }
    },
    {
      "id": "c3d4e5f6-3333-4000-8000-000000000002",
      "name": "Fetch UCAS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, -100],
      "parameters": {
        "url": "https://www.ucas.com/explore/search/undergraduate",
        "method": "GET",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      }
    },
    {
      "id": "c3d4e5f6-3333-4000-8000-000000000003",
      "name": "Fetch Complete Uni Guide",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 100],
      "parameters": {
        "url": "https://www.thecompleteuniversityguide.co.uk/",
        "method": "GET",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      }
    },
    {
      "id": "c3d4e5f6-3333-4000-8000-000000000004",
      "name": "Write UCAS File",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [460, -100],
      "parameters": {
        "fileName": "/srv/projects/mycoursematchmaker/raw/ucas-undergraduate-{{ $now.format('yyyy-MM-dd') }}.html",
        "dataPropertyName": "data"
      }
    },
    {
      "id": "c3d4e5f6-3333-4000-8000-000000000005",
      "name": "Write Uni Guide File",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [460, 100],
      "parameters": {
        "fileName": "/srv/projects/mycoursematchmaker/raw/complete-uni-guide-{{ $now.format('yyyy-MM-dd') }}.html",
        "dataPropertyName": "data"
      }
    },
    {
      "id": "c3d4e5f6-3333-4000-8000-000000000006",
      "name": "Insert UCAS Capture",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [680, -100],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO captures (source_url, file_path, captured_at, metadata)\nVALUES (\n  'https://www.ucas.com/explore/search/undergraduate',\n  '/srv/projects/mycoursematchmaker/raw/ucas-undergraduate-' || TO_CHAR(NOW(), 'YYYY-MM-DD') || '.html',\n  NOW(),\n  json_build_object('project', 'mycoursematchmaker', 'source', 'ucas')\n);"
      },
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "Workhorse DB"
        }
      }
    },
    {
      "id": "c3d4e5f6-3333-4000-8000-000000000007",
      "name": "Insert Uni Guide Capture",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [680, 100],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO captures (source_url, file_path, captured_at, metadata)\nVALUES (\n  'https://www.thecompleteuniversityguide.co.uk/',\n  '/srv/projects/mycoursematchmaker/raw/complete-uni-guide-' || TO_CHAR(NOW(), 'YYYY-MM-DD') || '.html',\n  NOW(),\n  json_build_object('project', 'mycoursematchmaker', 'source', 'complete_university_guide')\n);"
      },
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "Workhorse DB"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          { "node": "Fetch UCAS", "type": "main", "index": 0 },
          { "node": "Fetch Complete Uni Guide", "type": "main", "index": 0 }
        ]
      ]
    },
    "Fetch UCAS": {
      "main": [
        [{ "node": "Write UCAS File", "type": "main", "index": 0 }]
      ]
    },
    "Fetch Complete Uni Guide": {
      "main": [
        [{ "node": "Write Uni Guide File", "type": "main", "index": 0 }]
      ]
    },
    "Write UCAS File": {
      "main": [
        [{ "node": "Insert UCAS Capture", "type": "main", "index": 0 }]
      ]
    },
    "Write Uni Guide File": {
      "main": [
        [{ "node": "Insert Uni Guide Capture", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "tags": []
}
