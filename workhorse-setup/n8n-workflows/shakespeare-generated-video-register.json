      "parameters": {
        "operation": "executeQuery",
        "query": "WITH project AS (\n  SELECT id FROM projects WHERE slug = 'shakespeare-is-boring' LIMIT 1\n)\nINSERT INTO entities (\n  project_id, entity_type, name, description, raw_data, notes, status, first_seen_at, last_seen_at\n)\nSELECT\n  project.id,\n  'generated_video',\n  $1,\n  $2,\n  $3::jsonb,\n  $4,\n  'active',\n  NOW(),\n  NOW()\nFROM project;",
        "options": {
          "queryReplacement": "={{ ['Veo render — Shot ' + ($json.body.shotNumber || 0) + ' — ' + ($json.body.shotTitle || 'Untitled shot'), 'Generated from Veo Studio for ' + ($json.body.projectTitle || 'Shakespeare is Boring') + '. Prompt: ' + ($json.body.prompt || ''), JSON.stringify($json.body || {}), ($json.body.exportFileName || '')] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "Workhorse DB"
        }
      }
    },
